# Network the dashboard talks to: "mainnet" (Arc, chainId 5042) or "local" (arc-anvil fork of Arc mainnet).
VITE_NETWORK=local
VITE_RPC_URL=http://127.0.0.1:8545
# DocumentaryCredit address and the block it was deployed at (log scans start there).
VITE_CREDOC_ADDRESS=
VITE_CREDOC_FROM_BLOCK=0
# Relayer key, server side only: pays the gas of attestors' signed presentations. Never prefix with VITE_.
RELAYER_KEY=
